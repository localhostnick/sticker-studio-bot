# Telegram Bot API Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Database Connection (Async SQLite default)
DATABASE_URL=sqlite+aiosqlite:///sticker_bot.db

# Storage Directories
TEMP_DIRECTORY=./temp
STORAGE_DIRECTORY=./storage
LOGS_DIRECTORY=./logs

# Bot Configuration & Limits
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=52428800 # 50MB in bytes
MAX_IMAGES=120           # Max images per operation batch
BOT_USERNAME=StickerManagerBot # Optional fallback if not fetched dynamically from API
